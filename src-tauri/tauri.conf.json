{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Empty Folder Nuker",
  "version": "1.0.0",
  "identifier": "com.xssistant.emptyfoldernuker",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Empty Folder Nuker",
        "width": 432,
        "height": 230,
        "minWidth": 300,
        "minHeight": 150,
        "decorations": false,
        "shadow": false,
        "visible": false,
        "resizable": false,
        "center": true,
        "dragDropEnabled": true,
        "maximizable": false,
        "backgroundColor": "#11151d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
